---
// One entry card in a registry index. The whole card is the link.
//
// A short `code` (a status code) sits above the name in its status hue
// (`tone`); a long one (a header name) is the card's title, in mono.
interface Props {
  href: string;
  name: string;
  description?: string;
  /** Mono identifier, such as `409` or `Retry-After`. */
  code?: string;
  /** `lg` when the code is the name (header names). */
  codeWidth?: 'sm' | 'lg';
  /** Text colour for a short code, from a `tone` in src/config/themes.ts. */
  tone?: string;
  note?: string;
  /** Analytics hook, read by page scripts as data-track. */
  track?: string;
}

const { href, name, description, code, codeWidth = 'sm', tone = 'text-slate-950', note, track } = Astro.props;
const keyIsName = Boolean(code) && codeWidth === 'lg';
const shortKey = Boolean(code) && !keyIsName;
---

<li class="h-full">
  <a href={href} data-track={track} class="registry-card group">
    <span class="flex items-baseline justify-between gap-3">
      <span class="min-w-0">
        {shortKey && <span class={`block font-mono text-xl font-medium tabular-nums ${tone}`}>{code}</span>}
        <span class={`block ${keyIsName ? 'font-mono' : ''} font-medium text-slate-950 break-words`}>{keyIsName ? code : name}</span>
      </span>
      <svg class="registry-card-chevron h-4 w-4 shrink-0 text-slate-600" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m6 4 4 4-4 4" /></svg>
    </span>
    {description && <span class="mt-2 block text-sm leading-relaxed text-slate-700 line-clamp-3">{description}</span>}
    {note && <span class="mt-auto pt-3 block text-xs text-slate-600 tabular-nums">{note}</span>}
  </a>
</li>

<script>
  // The spotlight: a soft highlight that follows the pointer across a card.
  // It answers the reader's movement; nothing moves on its own.
  function initSpotlight() {
    for (const card of document.querySelectorAll<HTMLElement>('.registry-card')) {
      if (card.dataset.spot) continue;
      card.dataset.spot = 'true';
      card.addEventListener('pointermove', (e) => {
        const r = card.getBoundingClientRect();
        card.style.setProperty('--mx', `${e.clientX - r.left}px`);
        card.style.setProperty('--my', `${e.clientY - r.top}px`);
      });
    }
  }
  document.addEventListener('astro:page-load', initSpotlight);
</script>
