---
// One entry in a registry-style index. The whole row is the link, because a
// reader scanning a list of 63 codes is aiming at a row, not at a word in it.
//
// Columns: an optional mono key (a code, a header name), the entry's name, its
// one-line description, and an optional trailing note (a version, a price).
// Below sm the description drops under the name.
interface Props {
  href: string;
  name: string;
  description?: string;
  /** Mono identifier shown first, such as `409` or `Retry-After`. */
  code?: string;
  /** Width of the key column: `sm` for status codes, `lg` for header names. */
  codeWidth?: 'sm' | 'lg';
  note?: string;
  /** Analytics hook, read by page scripts as data-track. */
  track?: string;
}

const { href, name, description, code, codeWidth = 'sm', note, track } = Astro.props;

// A long key (a header name) is the name, so it takes the name's column.
const keyIsName = Boolean(code) && codeWidth === 'lg';
const shortKey = Boolean(code) && !keyIsName;

// A short key keeps its own column on a phone too, with the description
// indented under the name, so a code and its name stay on one line.
const columns = shortKey
  ? 'grid-cols-[3.5rem_minmax(0,1fr)] sm:grid-cols-[3.5rem_minmax(0,14rem)_minmax(0,1fr)]'
  : keyIsName
    ? 'grid-cols-1 sm:grid-cols-[minmax(0,20rem)_minmax(0,1fr)]'
    : 'grid-cols-1 sm:grid-cols-[minmax(0,20rem)_minmax(0,1fr)]';
---

<li class="border-b border-slate-300">
  <a
    href={href}
    data-track={track}
    class={`group grid ${columns} gap-x-6 gap-y-0.5 py-3 px-2 -mx-2 rounded-sm hover:bg-slate-100 transition-colors`}
  >
    {shortKey && <span class="font-mono text-slate-950 tabular-nums">{code}</span>}
    <span class={`${keyIsName ? 'font-mono text-ultra-600' : 'font-medium text-ultra-600'} group-hover:underline underline-offset-2 min-w-0 break-words`}>
      {keyIsName ? code : name}
    </span>
    {(description || note) && (
      <span class={`text-sm text-slate-700 sm:pt-0.5 min-w-0 flex gap-4 justify-between ${shortKey ? 'col-start-2 sm:col-start-auto' : ''}`}>
        {description && <span class="line-clamp-2">{description}</span>}
        {note && <span class="shrink-0 tabular-nums">{note}</span>}
      </span>
    )}
  </a>
</li>
