---
/**
 * The opening line of a reference page, set as the HTTP text it documents:
 * `HTTP/1.1 409 Conflict`, `Retry-After: 120`, `GET request-target HTTP/1.1`,
 * or an error's `type` URI.
 *
 * This is the one bold element on the page, so everything around it stays
 * quiet. The parts of the line that are protocol grammar (`lead`, `trail`)
 * are muted; the part that is this page's identity is full ink, and is the
 * page's h1 when `heading` is set.
 */
interface Props {
  identity: string;
  lead?: string;
  trail?: string;
  /** Render the identity as the page's h1. */
  heading?: boolean;
  /** Text the copy button puts on the clipboard. No button when absent. */
  copy?: string;
  copyLabel?: string;
  /** Left rule colour, from a `marker` in src/config/themes.ts. */
  marker?: string;
  /** Long values such as URIs use the smaller size so they wrap less. */
  size?: 'lg' | 'md';
}

const { identity, lead, trail, heading = false, copy, copyLabel = 'Copy', marker = 'border-paper-400', size = 'lg' } = Astro.props;
const Identity = heading ? 'h1' : 'span';
const sizeClass = size === 'lg' ? 'wire-lg' : 'wire-md';
// Let URIs and paths break after a slash rather than mid-segment.
const parts = identity.split(/(?<=\/)/);
---

<div class={`wire-hero flex items-start justify-between gap-4 border-l-4 pl-5 ${marker}`}>
  <div class={`wire-line ${sizeClass} font-mono text-paper-950 min-w-0`}>
    {lead && <span class="text-paper-600">{lead}</span>}<Identity class="inline font-mono font-medium">{parts.map((part, i) => <>{i > 0 && <wbr />}{part}</>)}</Identity>{trail && <span class="text-paper-600">{trail}</span>}
  </div>
  {copy && (
    <button
      type="button"
      class="wire-copy shrink-0 mt-1 px-2.5 py-1 rounded-md border border-paper-300 bg-paper-100 text-xs font-medium text-paper-800 hover:border-chartres-400 hover:text-chartres-700 transition-colors data-[copied]:border-emerald-600 data-[copied]:text-emerald-800"
      data-copy={copy}
      aria-label={`${copyLabel}: ${copy}`}
    >
      <span data-copy-idle>Copy</span><span data-copy-done hidden>Copied</span>
    </button>
  )}
</div>

<script>
  function initWireCopy() {
    for (const button of document.querySelectorAll<HTMLButtonElement>('.wire-copy')) {
      if (button.dataset.bound) continue;
      button.dataset.bound = 'true';
      button.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(button.dataset.copy ?? '');
        } catch {
          return;
        }
        const idle = button.querySelector<HTMLElement>('[data-copy-idle]');
        const done = button.querySelector<HTMLElement>('[data-copy-done]');
        button.dataset.copied = '';
        idle?.setAttribute('hidden', '');
        done?.removeAttribute('hidden');
        setTimeout(() => {
          delete button.dataset.copied;
          done?.setAttribute('hidden', '');
          idle?.removeAttribute('hidden');
        }, 1600);
      });
    }
  }
  document.addEventListener('astro:page-load', initWireCopy);
</script>
