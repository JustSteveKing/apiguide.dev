---
// A row of links to the sections of a long index page, for readers who know
// which section they want. Neutral on purpose: these are navigation, not
// categories, so they carry no hue (see DESIGN.md, "Contrast floors").
interface Item {
  href: string;
  label: string;
  count: number;
}

interface Props {
  items: Item[];
}

const { items } = Astro.props;
---

<nav aria-label="Sections on this page" class="mt-6">
  <ul class="flex flex-wrap gap-2">
    {items.map(item => (
      <li>
        <a
          href={item.href}
          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md border border-slate-300 bg-slate-100/50 text-sm text-slate-800 hover:border-ultra-400 hover:text-ultra-700 transition-colors"
        >
          {item.label}
          <span class="text-xs text-slate-700">{item.count}</span>
        </a>
      </li>
    ))}
  </ul>
</nav>
