---
interface Props {
  label: string;
  value?: string;
}

const { label, value } = Astro.props;
---
{/* One row per item on a phone, one cell per item from sm up. No box of its
    own: the panel it sits in is the box, and a box per item inside it cost a
    third of a phone screen before the content started. */}
<div class="flex items-baseline justify-between gap-4 py-2.5 border-b border-slate-300 last:border-b-0 sm:block sm:py-0 sm:border-b-0">
  <span class="block text-slate-700 font-medium text-xs sm:mb-1.5">{label}</span>
  <span class="text-slate-900 font-semibold text-sm text-right sm:text-left">
    {value !== undefined ? value : <slot />}
  </span>
</div>
