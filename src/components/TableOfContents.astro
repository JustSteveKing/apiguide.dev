---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
}

const { headings } = Astro.props;

// Only h2 and h3 make useful navigation targets; anything deeper is noise in a rail this narrow.
const items = headings.filter(h => h.depth === 2 || h.depth === 3);

// Below three entries a table of contents costs more attention than it saves.
const show = items.length >= 3;

// On a narrow screen the rail is hidden and the contents sit above the article
// instead, collapsed. That costs a tap and some height, so it is only worth it
// on the long-form pages: a three-section error page is shorter than its own
// contents would be. Only h2 entries, since this is for getting to the right
// part of the page, not for reading its outline.
const mobileItems = items.filter(h => h.depth === 2);
const showMobile = mobileItems.length >= 5;
---

{showMobile && (
  <details class="lg:hidden order-first mb-8 border border-slate-300 rounded-lg bg-slate-100/50 group">
    <summary class="flex items-center justify-between cursor-pointer list-none [&::-webkit-details-marker]:hidden px-4 py-3 text-sm font-semibold text-slate-800">
      <span>On this page <span class="font-normal text-slate-700">({mobileItems.length} sections)</span></span>
      <svg class="w-4 h-4 text-slate-700 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
      </svg>
    </summary>
    <ul class="border-t border-slate-300 px-4 py-3 space-y-2 text-sm">
      {mobileItems.map(h => (
        <li>
          <a href={`#${h.slug}`} class="block py-1 leading-snug text-slate-700 hover:text-ultra-700">{h.text}</a>
        </li>
      ))}
    </ul>
  </details>
)}

{show && (
  <aside class="hidden lg:block" aria-labelledby="toc-heading">
    <nav class="sticky top-24 border-l border-slate-300 pl-5" data-toc>
      <p id="toc-heading" class="text-xxs font-semibold text-slate-700 mb-3">
        On this page
      </p>
      <ul class="space-y-2 text-xs">
        {items.map(h => (
          <li class={h.depth === 3 ? 'pl-3' : ''}>
            <a
              href={`#${h.slug}`}
              data-toc-link={h.slug}
              class="block leading-snug text-slate-700 hover:text-ultra-700 transition-colors aria-[current=true]:text-ultra-700 aria-[current=true]:font-semibold"
            >
              {h.text}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </aside>
)}

<script>
  // The heading whose section the reader is currently in: the last one to have
  // passed the reading line near the top of the viewport. Kept as a pure function
  // of (heading offsets, scroll position) so it is testable without scrolling.
  function activeSlug(
    headings: { slug: string; top: number }[],
    scrollY: number,
    readingLine = 100
  ): string | null {
    if (!headings.length) return null;

    let active = headings[0].slug;
    for (const heading of headings) {
      if (heading.top - scrollY <= readingLine) active = heading.slug;
      else break;
    }
    return active;
  }

  function initToc() {
    const nav = document.querySelector('[data-toc]');
    if (!nav) return;

    const links = [...nav.querySelectorAll<HTMLAnchorElement>('[data-toc-link]')];
    const headings = links
      .map(link => {
        const slug = link.dataset.tocLink || '';
        const el = document.getElementById(slug);
        return el ? { slug, el } : null;
      })
      .filter((h): h is { slug: string; el: HTMLElement } => h !== null);

    if (!headings.length) return;

    // Offsets are read once per resize rather than per scroll frame.
    let offsets = headings.map(h => ({ slug: h.slug, top: h.el.getBoundingClientRect().top + window.scrollY }));
    const measure = () => {
      offsets = headings.map(h => ({ slug: h.slug, top: h.el.getBoundingClientRect().top + window.scrollY }));
    };

    let current: string | null = null;
    const sync = () => {
      const next = activeSlug(offsets, window.scrollY);
      if (next === current) return;
      current = next;
      links.forEach(link => link.setAttribute('aria-current', String(link.dataset.tocLink === next)));
    };

    let queued = false;
    const onScroll = () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(() => {
        queued = false;
        sync();
      });
    };

    sync();
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', () => {
      measure();
      sync();
    });
  }

  document.addEventListener('astro:page-load', initToc);
</script>
