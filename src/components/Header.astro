---
import Logo from "@/components/Logo.astro";
import { pagePath } from "@/utils/pagePath";

const pathname = pagePath(Astro.url);

// Matches a section index and everything under it, with or without a trailing slash.
const isActive = (path: string) => {
  const base = path.replace(/\/$/, '');
  return pathname === base || pathname.startsWith(base + '/');
};

const nav = [
  { href: '/errors', label: 'Errors' },
  { href: '/status-codes', label: 'Status codes' },
  { href: '/headers', label: 'Headers' },
  { href: '/methods', label: 'Methods' },
  { href: '/guides', label: 'Guides' },
  { href: '/specifications', label: 'Specs' },
  { href: '/tools', label: 'Tools' },
];
---
<header class="site-header sticky top-0 z-50 border-b border-slate-950/[0.08] bg-slate-50/70 backdrop-blur-xl backdrop-saturate-150">
  <div class="max-w-6xl mx-auto px-6 h-14 flex items-center justify-between gap-4">
    <a href="/" class="group shrink-0">
      <Logo size="sm" />
    </a>

    <nav class="hidden lg:flex items-center gap-0.5 text-sm" aria-label="Sections">
      {nav.map(item => (
        <a
          href={item.href}
          aria-current={isActive(item.href) ? 'page' : undefined}
          class={`px-3 py-1.5 rounded-full transition-colors ${isActive(item.href) ? 'text-slate-950 bg-slate-950/[0.08]' : 'text-slate-700 hover:text-slate-950 hover:bg-slate-950/[0.05]'}`}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-2">
      <button id="search-trigger" class="flex items-center gap-2 h-8 pl-3 pr-1.5 text-xs text-slate-700 hover:text-slate-950 bg-slate-950/[0.04] hover:bg-slate-950/[0.07] border border-slate-950/[0.08] rounded-full transition-colors cursor-pointer" aria-label="Open command palette search">
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
        <span class="pr-1">Search</span>
        <kbd class="hidden sm:inline-block px-1.5 py-0.5 text-xxs font-sans rounded-full bg-slate-950/[0.06] text-slate-700">⌘K</kbd>
      </button>

      <button id="theme-toggle" type="button" class="flex items-center justify-center w-8 h-8 rounded-full text-slate-700 hover:text-slate-950 hover:bg-slate-950/[0.06] border border-slate-950/[0.08] transition-colors cursor-pointer" aria-label="Switch to light theme" aria-pressed="false">
        <!-- Sun shows in dark (to switch to light), moon in light. -->
        <svg class="theme-icon-sun w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path stroke-linecap="round" d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32 1.41 1.41M2 12h2m16 0h2M4.93 19.07l1.41-1.41m11.32-11.32 1.41-1.41"/></svg>
        <svg class="theme-icon-moon w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z"/></svg>
      </button>

      <button
        id="mobile-menu-trigger"
        class="lg:hidden flex items-center justify-center w-8 h-8 rounded-full text-slate-700 hover:text-slate-950 hover:bg-slate-950/[0.06] border border-slate-950/[0.08] transition-colors cursor-pointer"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Toggle navigation menu"
      >
        <svg id="menu-icon" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="close-icon" class="w-4 h-4 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Opaque, and no blur of its own: a translucent menu inside a blurred
       header let the page show through (see the review-fixes branch). -->
  <div
    id="mobile-menu"
    class="hidden absolute top-full left-0 right-0 bg-slate-50 border-b border-slate-950/[0.08] shadow-2xl px-4 py-4 transition-all duration-200 transform -translate-y-2 opacity-0 z-40"
  >
    <nav class="flex flex-col gap-1 text-sm font-medium" aria-label="Sections">
      {nav.map(item => (
        <a
          href={item.href}
          aria-current={isActive(item.href) ? 'page' : undefined}
          class={`py-2.5 px-3 rounded-lg transition-colors ${isActive(item.href) ? 'text-slate-950 bg-slate-950/[0.07]' : 'text-slate-700 hover:text-slate-950 hover:bg-slate-950/[0.05]'}`}
        >
          {item.label}
        </a>
      ))}
    </nav>
  </div>
</header>

<script>
  function initMobileMenu() {
    const trigger = document.getElementById('mobile-menu-trigger');
    const menu = document.getElementById('mobile-menu');
    const menuIcon = document.getElementById('menu-icon');
    const closeIcon = document.getElementById('close-icon');

    if (!trigger || !menu || !menuIcon || !closeIcon) return;

    let isOpen = false;

    function toggleMenu(show) {
      isOpen = show !== undefined ? show : !isOpen;
      
      trigger.setAttribute('aria-expanded', isOpen ? 'true' : 'false');

      if (isOpen) {
        document.body.classList.add('overflow-hidden');
        menu.classList.remove('hidden');
        requestAnimationFrame(() => {
          menu.classList.remove('-translate-y-2', 'opacity-0');
          menu.classList.add('translate-y-0', 'opacity-100');
        });
        menuIcon.classList.add('hidden');
        closeIcon.classList.remove('hidden');
      } else {
        document.body.classList.remove('overflow-hidden');
        menu.classList.remove('translate-y-0', 'opacity-100');
        menu.classList.add('-translate-y-2', 'opacity-0');
        
        const onTransitionEnd = () => {
          if (!isOpen) {
            menu.classList.add('hidden');
          }
          menu.removeEventListener('transitionend', onTransitionEnd);
        };
        menu.addEventListener('transitionend', onTransitionEnd);

        menuIcon.classList.remove('hidden');
        closeIcon.classList.add('hidden');
      }
    }

    trigger.addEventListener('click', (e) => {
      e.stopPropagation();
      toggleMenu();
    });

    document.addEventListener('click', (e) => {
      if (isOpen && !menu.contains(e.target as Node) && !trigger.contains(e.target as Node)) {
        toggleMenu(false);
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isOpen) {
        toggleMenu(false);
      }
    });

    window.addEventListener('resize', () => {
      if (window.innerWidth >= 1024 && isOpen) {
        toggleMenu(false);
      }
    });

    // Close menu when a link inside it is clicked (supports instant router reactions)
    const links = menu.querySelectorAll('a');
    links.forEach(link => {
      link.addEventListener('click', () => {
        toggleMenu(false);
      });
    });
  }

  // Theme toggle. Until it is used the OS setting decides; once used, the
  // choice is stored and re-applied before paint by the inline script in
  // Layout.astro.
  function initThemeToggle() {
    const button = document.getElementById('theme-toggle');
    if (!button) return;
    const sync = () => {
      const light = document.documentElement.dataset.theme === 'light';
      button.setAttribute('aria-label', light ? 'Switch to dark theme' : 'Switch to light theme');
      button.setAttribute('aria-pressed', light ? 'true' : 'false');
    };
    sync();
    button.addEventListener('click', () => {
      const next = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
      document.documentElement.dataset.theme = next;
      localStorage.setItem('theme', next);
      document.querySelector('meta[name="theme-color"]')?.setAttribute('content', next === 'light' ? '#F7F8FA' : '#0A0C11');
      sync();
    });
  }

  // Hook into Astro page load for View Transitions compatibility
  document.addEventListener('astro:page-load', () => {
    initMobileMenu();
    initThemeToggle();
  });
</script>
