---
// One group of a registry index: a heading with its count, then a grid of
// entry cards. The dot carries the group's status hue (a `dot` from
// src/config/themes.ts); groups without one get a neutral dot.
interface Props {
  id: string;
  title: string;
  /** Short mono prefix for the heading, such as `4xx`. */
  code?: string;
  count: number;
  blurb?: string;
  dot?: string;
  /** Columns at lg. Long-form entries (guides) read better two-up. */
  columns?: 2 | 3;
}

const { id, title, code, count, blurb, dot = 'bg-slate-500', columns = 3 } = Astro.props;
---

<section aria-labelledby={id} class="mb-16 last:mb-0">
  <div class="flex items-center gap-3">
    <span class={`h-2 w-2 rounded-full ${dot}`} aria-hidden="true"></span>
    <h2 id={id} class="text-lg font-semibold tracking-tight text-slate-950">
      {code && <span class="font-mono font-medium text-slate-700 mr-2">{code}</span>}{title}
    </h2>
    <span class="rounded-full border border-slate-950/[0.08] bg-slate-950/[0.04] px-2 py-0.5 text-xs text-slate-700 tabular-nums">{count}</span>
  </div>
  {blurb && <p class="mt-2 text-sm text-slate-700 max-w-2xl">{blurb}</p>}
  <ul class={`mt-5 grid gap-3 sm:grid-cols-2 ${columns === 3 ? 'lg:grid-cols-3' : ''}`}>
    <slot />
  </ul>
</section>
