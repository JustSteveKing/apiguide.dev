---
import { pagePath, pageURL } from "@/utils/pagePath";
// Self-hosted variable fonts. These replace three render-blocking requests to
// fonts.googleapis.com: one for the stylesheet, then the font files it points
// at on a second origin. Served from this origin they are one hop, they carry
// the site's own cache headers, and no reader's IP reaches a third party.
// Each entry point is subsetted by unicode-range, so a page downloads only the
// ranges it actually uses, and the italic faces only load where italics appear.
import "@fontsource-variable/inter";
import "@fontsource-variable/inter/wght-italic.css";
import "@fontsource-variable/fira-code";

import "@/styles/main.css";
import { ClientRouter } from 'astro:transitions';
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Sponsors from "@/components/Sponsors.astro";
import CommandPalette from "@/components/CommandPalette.astro";
import PostHog from "@/components/posthog.astro";

interface Props {
	title?: string;
	description?: string;
	jsonLd?: Record<string, any> | Record<string, any>[];
	/** Keep the page out of search indexes and drop its canonical link. */
	noindex?: boolean;
}

const { 
	title = "apiguide.dev | API Reference & Design Patterns", 
	description = "The flagship reference site for modern, authoritative API design patterns, Problem+JSON error schemas, and integration guides.",
	jsonLd,
	noindex = false
} = Astro.props;

// Compile a stable canonical URL
const canonicalURL = pageURL(Astro.url, Astro.site);

// Compile the Open Graph PNG preview image path dynamically
let ogImagePath = "index.png";
const pathParts = pagePath(Astro.url).replace(/^\/|\/$/g, ""); // strip leading/trailing slashes
if (pathParts) {
	ogImagePath = `${pathParts}.png`;
}
const ogImageURL = new URL(`/og/${ogImagePath}`, Astro.site || "https://apiguide.dev");

// Resolve JSON-LD array inputs into single @graph schema arrays
const jsonLdPayload = Array.isArray(jsonLd)
  ? { 
      "@context": "https://schema.org", 
      "@graph": jsonLd.map(item => {
        const { "@context": _, ...rest } = item;
        return rest;
      }) 
    }
  : jsonLd;
---

<!doctype html>
<html lang="en" class="h-full bg-slate-50 text-slate-900 scroll-smooth">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" type="image/png" href="/favicon-32x32.png" sizes="32x32" />
		<link rel="icon" type="image/png" href="/favicon-192x192.png" sizes="192x192" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/manifest.json" />
		<meta name="generator" content={Astro.generator} />
		
		<!-- Google Fonts -->
		<!-- Match the browser chrome to the page in both themes. -->
		<meta name="theme-color" content="#0A0C11">
		<!-- Apply the stored theme before first paint, and again after every view
		     transition (the swap replaces <html> attributes). Dark is the default. -->
		<script is:inline>
			(function () {
				function apply() {
					var theme = localStorage.getItem('theme') === 'light' ? 'light' : 'dark';
					document.documentElement.dataset.theme = theme;
					var meta = document.querySelector('meta[name="theme-color"]');
					if (meta) meta.setAttribute('content', theme === 'light' ? '#F7F8FA' : '#0A0C11');
				}
				apply();
				document.addEventListener('astro:after-swap', apply);
			})();
		</script>

		<!-- SEO Meta Tags -->
		<title>{title}</title>
		<meta name="description" content={description} />
		{noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonicalURL.href} />}

		<!-- Open Graph / Facebook -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalURL.href} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImageURL.href} />

		<!-- Twitter -->
		<meta property="twitter:card" content="summary_large_image" />
		<meta property="twitter:url" content={canonicalURL.href} />
		<meta property="twitter:title" content={title} />
		<meta property="twitter:description" content={description} />
		<meta property="twitter:image" content={ogImageURL.href} />

		<!-- JSON-LD Structured Data Injection -->
		{jsonLdPayload && (
			<script type="application/ld+json" set:html={JSON.stringify(jsonLdPayload)} />
		)}

		<!-- View Transitions -->
		<ClientRouter />

		<!-- PostHog Analytics -->
		<PostHog />
	</head>
	<body class="flex flex-col min-h-screen bg-slate-50 text-slate-900 selection:bg-ultra-200 selection:text-ultra-950 font-sans antialiased">
		<a
			href="#main-content"
			class="sr-only focus:not-sr-only focus:whitespace-nowrap focus:fixed focus:top-3 focus:left-3 focus:z-100 focus:rounded-lg focus:border focus:border-slate-300 focus:bg-slate-50 focus:px-4 focus:py-2.5 focus:text-sm focus:font-semibold focus:text-ultra-700 focus:shadow-lg"
		>Skip to main content</a>
		<!-- Persistent Sticky Header -->
		<Header />

		<!-- Main Content Slot -->
		<div id="main-content" tabindex="-1" class="grow">
			<slot />
		</div>

		<!-- Sponsors band (site-wide, just above the footer) -->
		<Sponsors />

		<!-- Persistent Footer -->
		<Footer />

		<!-- Command Palette Search Overlay -->
		<CommandPalette />

		<script>
			// Give every long-form heading a copyable link, so sections can be cited directly.
			document.addEventListener('astro:page-load', () => {
				document.querySelectorAll<HTMLElement>('.prose h2[id], .prose h3[id]').forEach(heading => {
					if (heading.querySelector('.heading-anchor')) return;

					const anchor = document.createElement('a');
					anchor.className = 'heading-anchor';
					anchor.href = `#${heading.id}`;
					anchor.textContent = '#';
					anchor.setAttribute('aria-label', `Link to section: ${heading.textContent?.trim() ?? ''}`);
					heading.appendChild(anchor);
				});
			});
		</script>


	</body>
</html>
