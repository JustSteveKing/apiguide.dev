---
import { getCollection } from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import RegistryGroup from '@/components/RegistryGroup.astro';
import RegistryRow from '@/components/RegistryRow.astro';
import { getWebSiteSchema } from '../utils/jsonLd';

const [errors, statusCodes, headers, methods, guides, specifications, tools] = await Promise.all([
  getCollection('errors'),
  getCollection('statusCodes'),
  getCollection('headers'),
  getCollection('methods'),
  getCollection('guides'),
  getCollection('specifications'),
  getCollection('tools'),
]);

const homeJsonLd = getWebSiteSchema();

/**
 * The hero: one real exchange, printed the way `curl -v` prints it, with
 * every part that has a page here linked to it. It is the example from
 * /errors/validation-failed, so following the type URI lands on a page that
 * shows the same response.
 */
type Segment = { text: string; href?: string; muted?: boolean };
const m = (text: string): Segment => ({ text, muted: true });
const t = (text: string): Segment => ({ text });
const l = (text: string, href: string): Segment => ({ text, href });

// Break long values after a slash, not mid-word, when the transcript wraps.
const pieces = (text: string) => text.split(/(?<=\/)/);

const transcript: Segment[][] = [
  [m('> '), l('POST', '/methods/post'), t(' /v1/leads HTTP/1.1')],
  [m('> '), l('Content-Type', '/headers/content-type'), t(': application/json')],
  [m('>')],
  [m('> '), t('{"start_date": "2026-10-01", "end_date": "2026-09-01"}')],
  [t(' ')],
  [m('< '), t('HTTP/1.1 '), l('422 Unprocessable Entity', '/status-codes/422')],
  [m('< '), l('Content-Type', '/headers/content-type'), t(': '), l('application/problem+json', '/problem-json')],
  [m('<')],
  [t('{')],
  [t('  "type": "'), l('https://apiguide.dev/errors/validation-failed', '/errors/validation-failed'), t('",')],
  [t('  "title": "Validation Failed",')],
  [t('  "status": 422,')],
  [t('  "detail": "The end_date must be a date after start_date.",')],
  [t('  "errors": {')],
  [t('    "end_date": ["The end_date must be a date after start_date."]')],
  [t('  },')],
  [t('  "instance": "/v1/leads"')],
  [t('}')],
];

const sections = [
  { href: '/errors', name: 'Errors', description: 'Problem types to use as the type of an RFC 9457 response.', count: errors.length },
  { href: '/status-codes', name: 'Status codes', description: 'When to send each code, and which one to send instead.', count: statusCodes.length },
  { href: '/headers', name: 'Headers', description: 'Request and response headers, with an example line for each.', count: headers.length },
  { href: '/methods', name: 'Methods', description: 'Whether each method is safe, idempotent and cacheable.', count: methods.length },
  { href: '/guides', name: 'Guides', description: 'Long-form design guides, from the shape of a resource to what a model makes of it.', count: guides.length },
  { href: '/specifications', name: 'Specifications', description: 'OpenAPI, AsyncAPI, JSON Schema and the other formats that describe an API.', count: specifications.length },
  { href: '/tools', name: 'Tools', description: 'Tools for designing, testing, running and watching an API.', count: tools.length },
  { href: '/problem-json', name: 'Problem+JSON', description: 'How RFC 9457 problem responses work, field by field.' },
];

// Starting points by problem rather than by section. Each lists the pages
// that answer it, in the order you would read them.
const problems: { question: string; links: { text: string; href: string; mono?: boolean }[] }[] = [
  {
    question: 'Rate limiting a client',
    links: [
      { text: '429', href: '/status-codes/429', mono: true },
      { text: 'Retry-After', href: '/headers/retry-after', mono: true },
      { text: 'Rate limit exceeded', href: '/errors/rate-limit-exceeded' },
    ],
  },
  {
    question: 'Rejecting an update made against a stale copy',
    links: [
      { text: 'ETag', href: '/headers/etag', mono: true },
      { text: 'If-Match', href: '/headers/if-match', mono: true },
      { text: '412', href: '/status-codes/412', mono: true },
    ],
  },
  {
    question: 'Reporting validation errors',
    links: [
      { text: '422', href: '/status-codes/422', mono: true },
      { text: 'Validation failed', href: '/errors/validation-failed' },
      { text: 'Problem+JSON', href: '/problem-json' },
    ],
  },
  {
    question: 'Making retries safe',
    links: [
      { text: 'Idempotency-Key', href: '/headers/idempotency-key', mono: true },
      { text: 'POST', href: '/methods/post', mono: true },
      { text: 'Idempotency guide', href: '/guides/idempotency' },
    ],
  },
];
---

<Layout
  title="apiguide.dev | Authoritative HTTP & API Reference"
  description="The flagship catalog for HTTP status codes, headers, request methods, and Problem+JSON error schemas for web APIs."
  jsonLd={homeJsonLd}
>
  <main class="max-w-6xl mx-auto px-6 py-16 font-sans">

    <div class="mb-20 grid gap-10 lg:grid-cols-[minmax(0,22rem)_minmax(0,1fr)] lg:gap-12 lg:items-start">
    <header class="max-w-2xl lg:pt-4">
      <h1 class="text-4xl sm:text-5xl font-bold tracking-tight leading-tight mb-4 text-slate-950">
        Look up any part of an HTTP API
      </h1>
      <p class="text-lg text-slate-700 leading-relaxed mb-6">
        Status codes, headers, methods and RFC 9457 problem types, each on its own page that says when to use it and what to use instead.
      </p>
      <button
        id="hero-search-trigger"
        type="button"
        class="inline-flex items-center gap-3 px-4 py-2.5 text-slate-700 bg-slate-100 hover:border-ultra-400 border border-slate-300 rounded-lg transition-colors"
      >
        <svg class="w-4 h-4 text-slate-700" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
        <span>Search the reference</span>
        <kbd class="hidden sm:inline-block ml-4 px-1.5 py-0.5 text-xs font-sans bg-slate-50 border border-slate-300 rounded text-slate-700">⌘K</kbd>
      </button>
    </header>

    <figure>
      <pre class="exchange font-mono text-slate-950 bg-slate-100 border border-slate-300 rounded-lg px-5 py-5 sm:px-8 sm:py-7"><code>{transcript.map(line => (
        <span class="exchange-line">{line.map(seg => seg.href
          ? <a href={seg.href} data-track="exchange" class="text-ultra-700 underline decoration-ultra-300 decoration-1 underline-offset-4 hover:decoration-ultra-700 hover:decoration-2">{pieces(seg.text).map((piece, i) => <>{i > 0 && <wbr />}{piece}</>)}</a>
          : <span class={seg.muted ? 'text-slate-600' : undefined}>{pieces(seg.text).map((piece, i) => <>{i > 0 && <wbr />}{piece}</>)}</span>
        )}</span>
      ))}</code></pre>
      <figcaption class="mt-3 text-sm text-slate-700">
        A request that fails validation, as <code class="font-mono">curl -v</code> shows it. Every underlined part has a page here.
      </figcaption>
    </figure>
    </div>

    <div class="grid gap-16 lg:grid-cols-[minmax(0,1fr)_minmax(0,22rem)]">
      <RegistryGroup id="sections" title="Sections" count={sections.length}>
        {sections.map(s => (
          <RegistryRow href={s.href} name={s.name} description={s.description} note={s.count !== undefined ? String(s.count) : undefined} track="catalog" />
        ))}
      </RegistryGroup>

      <section aria-labelledby="problems">
        <div class="flex items-baseline gap-3 border-l-4 border-slate-400 pl-4">
          <h2 id="problems" class="text-xl font-bold tracking-tight text-slate-950">Start from the problem</h2>
        </div>
        <dl class="mt-4 border-t border-slate-300">
          {problems.map(p => (
            <div class="border-b border-slate-300 py-3">
              <dt class="font-medium text-slate-950">{p.question}</dt>
              <dd class="mt-1 text-sm text-slate-700">
                {p.links.map((link, i) => (
                  <>{i > 0 && ', '}<a href={link.href} data-track="scenario" class={`text-ultra-600 hover:text-ultra-800 hover:underline ${link.mono ? 'font-mono' : ''}`}>{link.text}</a></>
                ))}
              </dd>
            </div>
          ))}
        </dl>
      </section>
    </div>

  </main>

  <script>
    document.addEventListener('astro:page-load', () => {
      const trigger = document.getElementById('hero-search-trigger');
      const palette = document.getElementById('command-palette');
      const input = document.getElementById('palette-input') as HTMLInputElement | null;

      if (trigger && palette && input) {
        trigger.addEventListener('click', () => {
          (window as any).posthog?.capture('hero_search_trigger_clicked');
          palette.classList.remove('hidden');
          palette.classList.add('flex');
          setTimeout(() => {
            const container = document.getElementById('palette-container');
            if (container) {
              container.classList.remove('scale-95', 'opacity-0');
              container.classList.add('scale-100', 'opacity-100');
            }
            input.focus();
          }, 50);
        });
      }
    });
  </script>

  <script is:inline>
    document.addEventListener('astro:page-load', function () {
      // Section row clicks (the event keeps its card-era name so dashboards still join up).
      document.querySelectorAll('main a[data-track="catalog"]').forEach(function (link) {
        link.addEventListener('click', function () {
          window.posthog?.capture('catalog_card_clicked', {
            section_name: (link.querySelector('span') || link).textContent.trim(),
            section_url: link.getAttribute('href') || '',
          });
        });
      });

      // "Start from the problem" link clicks.
      document.querySelectorAll('main a[data-track="scenario"]').forEach(function (link) {
        link.addEventListener('click', function () {
          window.posthog?.capture('api_scenario_resource_clicked', {
            resource_label: link.textContent ? link.textContent.trim() : '',
            resource_url: link.getAttribute('href') || '',
          });
        });
      });
    });
  </script>
</Layout>
