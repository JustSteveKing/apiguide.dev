---
import { pageURL } from "@/utils/pagePath";
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import TableOfContents from '@/components/TableOfContents.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import MetaItem from '../../components/MetaItem.astro';
import Provenance from '@/components/Provenance.astro';

export async function getStaticPaths() {
  const headers = await getCollection('headers');
  return headers.map(h => ({
    params: { slug: h.id },
    props: { h },
  }));
}

const { h } = Astro.props;
const { Content, headings } = await render(h);

// Fetch all status codes to cross-reference related codes
const allCodes = await getCollection('statusCodes');
const relatedCodes = h.data.relatedCodes
  ? allCodes.filter(c => h.data.relatedCodes.includes(c.data.code))
  : [];
const sortedRelatedCodes = relatedCodes.sort((a, b) => a.data.code - b.data.code);

import { headerCategoryThemes } from '../../config/themes';

const activeTheme = headerCategoryThemes[h.data.category];
const example = headerExampleValue(h.body, h.data.name);


import { getTechArticleSchema, getBreadcrumbSchema } from '../../utils/jsonLd';
import WireHero from '@/components/WireHero.astro';
import { headerExampleValue } from '@/utils/wireExample';
import RegistryGroup from '@/components/RegistryGroup.astro';
import RegistryRow from '@/components/RegistryRow.astro';
import { statusCategoryThemes } from '@/config/themes';

const headerJsonLd = [
  getTechArticleSchema({
    headline: `${h.data.name} HTTP Header Reference`,
    description: h.data.description,
    url: pageURL(Astro.url, Astro.site).href,
    category: activeTheme.label
  }),
  getBreadcrumbSchema([
    { name: "HTTP Headers", path: "/headers" },
    { name: h.data.name, path: `/headers/${h.id}` }
  ])
];
---

<Layout 
  title={`${h.data.name} HTTP Header Reference | apiguide.dev`}
  description={`Detailed usage patterns, RFC specifications, and status code correlations for the HTTP ${h.data.name} header.`}
  jsonLd={headerJsonLd}
>
  <main class="max-w-6xl mx-auto px-6 py-16 font-sans">
    <!-- Breadcrumbs Component -->
    <Breadcrumbs items={[
      { name: "Headers", href: "/headers" },
      { name: h.data.name }
    ]} />

    <!-- Title & Metadata -->
    <header class="mb-10">
      <WireHero
        identity={h.data.name}
        heading
        trail={example ? `: ${example}` : ':'}
        copy={example ? `${h.data.name}: ${example}` : h.data.name}
        copyLabel="Copy header line"
        dot={activeTheme.dot}
        label={activeTheme.label}
      />
      <p class="text-lg text-slate-700 mt-6 mb-8 max-w-2xl">
        {h.data.description}
      </p>

      <div class="grid grid-cols-1 sm:flex sm:flex-wrap sm:gap-x-12 sm:gap-y-4 py-1 sm:py-4 border-y border-slate-300 text-sm">
        <MetaItem label="Direction" value={activeTheme.label} />
        <MetaItem label="Status" value={h.data.standard ? 'Standardized' : 'Not standardized'} />
        {h.data.relatedCodes && h.data.relatedCodes.length > 0 && (
          <MetaItem label="Seen with">
            {h.data.relatedCodes.map((code, i) => (
              <>{i > 0 && ', '}<a href={`/status-codes/${code}`} class="text-ultra-600 hover:text-ultra-800 hover:underline">{code}</a></>
            ))}
          </MetaItem>
        )}
        <Provenance reference={h.data.reference} updatedDate={h.data.updatedDate} />
      </div>
    </header>

    <!-- Markdown Content Body -->
    <div class="border-b border-slate-300 pb-10 flex flex-col lg:grid lg:grid-cols-[minmax(0,60ch)_minmax(0,1fr)] lg:gap-10">
      <article class="prose max-w-[60ch]">
        <Content />
      </article>
      <TableOfContents headings={headings} />
    </div>

    {sortedRelatedCodes.length > 0 && (
      <div class="mt-12">
        <RegistryGroup id="related-codes" title="Status codes seen with it" count={sortedRelatedCodes.length}>
          {sortedRelatedCodes.map(c => (
            <RegistryRow href={`/status-codes/${c.data.code}`} code={String(c.data.code)} tone={statusCategoryThemes[c.data.category].tone} name={c.data.title} description={c.data.description} />
          ))}
        </RegistryGroup>
      </div>
    )}
  </main>
</Layout>


