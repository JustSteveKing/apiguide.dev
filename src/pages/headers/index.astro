---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import IndexHeader from '@/components/IndexHeader.astro';
import SectionJump from '@/components/SectionJump.astro';
import RegistryGroup from '@/components/RegistryGroup.astro';
import RegistryRow from '@/components/RegistryRow.astro';
import { headerCategoryThemes } from '@/config/themes';

const headers = (await getCollection('headers')).sort((a, b) => a.data.name.localeCompare(b.data.name));

const groups = [
  { key: 'request', title: 'Request headers' },
  { key: 'response', title: 'Response headers' },
  { key: 'both', title: 'Request and response' },
] as const;

const filled = groups
  .map(g => ({ ...g, entries: headers.filter(h => h.data.category === g.key) }))
  .filter(g => g.entries.length > 0);
---

<Layout
  title="API HTTP Headers Reference | apiguide.dev"
  description="Reference directory of the key HTTP headers used in REST APIs, including request authorization, conditional checks, caching, and rate limiting headers."
>
  <main class="max-w-6xl mx-auto px-6 py-16 font-sans">
    <IndexHeader
      crumb="Headers"
      title="Headers"
      intro="The request and response headers HTTP APIs rely on, with what each one does and an example line."
    >
      <SectionJump items={filled.map(g => ({ href: `#dir-${g.key}`, label: g.title, count: g.entries.length }))} />
    </IndexHeader>

    {filled.map(g => (
      <RegistryGroup id={`dir-${g.key}`} title={g.title} count={g.entries.length} marker={headerCategoryThemes[g.key].marker}>
        {g.entries.map(h => (
          <RegistryRow href={`/headers/${h.id}`} code={h.data.name} codeWidth="lg" name={h.data.name} description={h.data.description} note={h.data.standard ? undefined : 'Not standardized'} />
        ))}
      </RegistryGroup>
    ))}
  </main>
</Layout>
