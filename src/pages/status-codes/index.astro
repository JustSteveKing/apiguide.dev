---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import IndexHeader from '@/components/IndexHeader.astro';
import SectionJump from '@/components/SectionJump.astro';
import RegistryGroup from '@/components/RegistryGroup.astro';
import RegistryRow from '@/components/RegistryRow.astro';
import { statusCategoryThemes } from '@/config/themes';

const sortedCodes = (await getCollection('statusCodes')).sort((a, b) => a.data.code - b.data.code);

const classes = [
  { key: 'informational', code: '1xx', title: 'Informational' },
  { key: 'success', code: '2xx', title: 'Success' },
  { key: 'redirection', code: '3xx', title: 'Redirection' },
  { key: 'client-error', code: '4xx', title: 'Client errors' },
  { key: 'server-error', code: '5xx', title: 'Server errors' },
] as const;

const groups = classes
  .map(c => ({ ...c, codes: sortedCodes.filter(sc => sc.data.category === c.key) }))
  .filter(g => g.codes.length > 0);
---

<Layout
  title="HTTP Status Codes Catalog | apiguide.dev"
  description="The ultimate developer reference for all standard HTTP status codes (1xx, 2xx, 3xx, 4xx, 5xx) with REST API best practices."
>
  <main class="max-w-6xl mx-auto px-6 py-16 font-sans">
    <IndexHeader
      crumb="Status codes"
      title="Status codes"
      intro="The status codes an API sends, grouped by class. Each page says when to send the code and which one to send instead."
    >
      <SectionJump items={groups.map(g => ({ href: `#class-${g.code}`, label: `${g.code} ${g.title}`, count: g.codes.length }))} />
    </IndexHeader>

    {groups.map(g => (
      <RegistryGroup id={`class-${g.code}`} code={g.code} title={g.title} count={g.codes.length} dot={statusCategoryThemes[g.key].dot}>
        {g.codes.map(sc => (
          <RegistryRow href={`/status-codes/${sc.data.code}`} code={String(sc.data.code)} tone={statusCategoryThemes[g.key].tone} name={sc.data.title} description={sc.data.description} />
        ))}
      </RegistryGroup>
    ))}
  </main>
</Layout>
