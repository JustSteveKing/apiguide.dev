---
import { pageURL } from "@/utils/pagePath";
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import TableOfContents from '@/components/TableOfContents.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import MetaItem from '../../components/MetaItem.astro';

export async function getStaticPaths() {
  const statusCodes = await getCollection('statusCodes');
  return statusCodes.map(sc => ({
    params: { code: String(sc.data.code) },
    props: { sc },
  }));
}

const { sc } = Astro.props;
const { Content, headings } = await render(sc);

// Fetch all specific errors that share this HTTP status code
const allErrors = await getCollection('errors');
const matchingErrors = allErrors.filter(e => e.data.statusCode === sc.data.code);

// Fetch all headers that are related to this HTTP status code
const allHeaders = await getCollection('headers');
const matchingHeaders = allHeaders.filter(h => h.data.relatedCodes?.includes(sc.data.code));

// Cross-reference explicitly related status codes
const allStatusCodes = await getCollection('statusCodes');
const relatedStatusCodes = sc.data.relatedCodes
  ? allStatusCodes.filter(c => sc.data.relatedCodes.includes(c.data.code))
  : [];
const sortedRelatedCodes = relatedStatusCodes.sort((a, b) => a.data.code - b.data.code);


import { statusCategoryThemes } from '../../config/themes';

const activeTheme = statusCategoryThemes[sc.data.category];

import { getTechArticleSchema, getBreadcrumbSchema } from '../../utils/jsonLd';
import WireHero from '@/components/WireHero.astro';
import RegistryGroup from '@/components/RegistryGroup.astro';
import RegistryRow from '@/components/RegistryRow.astro';
import { excerpt } from '@/utils/excerpt';

const scJsonLd = [
  getTechArticleSchema({
    headline: `HTTP ${sc.data.code} ${sc.data.title} Reference`,
    description: sc.data.description,
    url: pageURL(Astro.url, Astro.site).href,
    category: activeTheme.label
  }),
  getBreadcrumbSchema([
    { name: "HTTP Status Codes", path: "/status-codes" },
    { name: `HTTP ${sc.data.code}`, path: `/status-codes/${sc.data.code}` }
  ])
];
---

<Layout 
  title={`HTTP ${sc.data.code} ${sc.data.title} | HTTP Status Code Reference`}
  description={`Detailed guide explaining when and how to use HTTP status code ${sc.data.code} (${sc.data.title}) in REST APIs, including specific error subtypes.`}
  jsonLd={scJsonLd}
>
  <main class="max-w-6xl mx-auto px-6 py-16 font-sans">
    <!-- Breadcrumbs Component -->
    <Breadcrumbs items={[
      { name: "Status codes", href: "/status-codes" },
      { name: `${sc.data.code} ${sc.data.title}` }
    ]} />

    <!-- Title & Metadata -->
    <header class="mb-10">
      <WireHero
        lead="HTTP/1.1 "
        identity={`${sc.data.code} ${sc.data.title}`}
        heading
        copy={`HTTP/1.1 ${sc.data.code} ${sc.data.title}`}
        copyLabel="Copy status line"
        marker={activeTheme.marker}
      />
      <p class="text-lg text-paper-700 mt-6 mb-8 max-w-2xl">
        {sc.data.description}
      </p>

      <div class="grid grid-cols-1 sm:flex sm:flex-wrap sm:gap-x-12 sm:gap-y-4 py-1 sm:py-4 border-y border-paper-300 text-sm">
        <MetaItem label="Category" value={activeTheme.label} />
        <MetaItem label="API error types" value={`${matchingErrors.length} ${matchingErrors.length === 1 ? 'error schema' : 'error schemas'}`} />
        <MetaItem label="Related headers" value={`${matchingHeaders.length} ${matchingHeaders.length === 1 ? 'header' : 'headers'}`} />
      </div>
    </header>

    <!-- Markdown Content Body -->
    <div class="border-b border-paper-300 pb-10 flex flex-col lg:grid lg:grid-cols-[minmax(0,60ch)_minmax(0,1fr)] lg:gap-10">
      <article class="prose max-w-[60ch]">
        <Content />
      </article>
      <TableOfContents headings={headings} />
    </div>

    {matchingErrors.length > 0 && (
      <div class="mt-12">
        <RegistryGroup id="error-types" title={`Problem types for ${sc.data.code}`} count={matchingErrors.length}>
          {matchingErrors.map(e => (
            <RegistryRow href={`/errors/${e.id}`} name={e.data.title} description={excerpt(e.body, 140)} note={e.data.deprecated ? 'Deprecated' : undefined} />
          ))}
        </RegistryGroup>
      </div>
    )}

    {matchingHeaders.length > 0 && (
      <div class="mt-12">
        <RegistryGroup id="related-headers" title="Headers seen with it" count={matchingHeaders.length}>
          {matchingHeaders.map(h => (
            <RegistryRow href={`/headers/${h.id}`} code={h.data.name} codeWidth="lg" name={h.data.name} description={h.data.description} />
          ))}
        </RegistryGroup>
      </div>
    )}

    {sortedRelatedCodes.length > 0 && (
      <div class="mt-12">
        <RegistryGroup id="related-codes" title="Codes to compare" count={sortedRelatedCodes.length}>
          {sortedRelatedCodes.map(c => (
            <RegistryRow href={`/status-codes/${c.data.code}`} code={String(c.data.code)} name={c.data.title} description={c.data.description} />
          ))}
        </RegistryGroup>
      </div>
    )}
  </main>
</Layout>


