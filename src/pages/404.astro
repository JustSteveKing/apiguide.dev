---
import Layout from '../layouts/Layout.astro';
import RegistryGroup from '@/components/RegistryGroup.astro';
import RegistryRow from '@/components/RegistryRow.astro';
import WireHero from '@/components/WireHero.astro';

// Served by Cloudflare for any path the build did not emit. A static page
// cannot see which path was asked for, so it says what most misses here are:
// an /errors/<name> problem type that does not exist, or a mistyped slug.
const sections = [
  { name: 'Errors', href: '/errors', description: 'Problem types for RFC 9457 responses.' },
  { name: 'Status codes', href: '/status-codes', description: 'Every code and when to send it.' },
  { name: 'Headers', href: '/headers', description: 'Request and response headers.' },
  { name: 'Methods', href: '/methods', description: 'Safety, idempotency, cacheability.' },
  { name: 'Guides', href: '/guides', description: 'Long-form API design guides.' },
  { name: 'Specifications', href: '/specifications', description: 'OpenAPI, AsyncAPI and the rest.' },
  { name: 'Tools', href: '/tools', description: 'Tools by what they do.' },
];
---

<Layout
  title="Page Not Found | apiguide.dev"
  description="There is no page at this address."
  noindex
>
  <main class="max-w-6xl mx-auto px-6 py-16 font-sans">
    <header class="mb-12 max-w-2xl">
      <WireHero lead="HTTP/1.1 " identity="404 Not Found" dot="bg-amber-500" label="Client error (4xx)" />
      <h1 class="mt-8 text-2xl font-bold tracking-tight text-slate-950">There is no page at this address</h1>
      <p class="mt-3 text-lg text-slate-700">
        If you followed the <code class="font-mono">type</code> of a problem response, that problem type is not in
        the <a href="/errors" class="text-ultra-600 hover:text-ultra-800 hover:underline">errors catalog</a>.
        Otherwise the address is mistyped or the page has moved. Search with
        <kbd class="px-1.5 py-0.5 rounded border border-slate-300 bg-slate-100 text-sm">⌘K</kbd>,
        or start from a section.
      </p>
    </header>

    <RegistryGroup id="sections" title="Sections" count={sections.length}>
      {sections.map(s => <RegistryRow href={s.href} name={s.name} description={s.description} />)}
    </RegistryGroup>
  </main>
</Layout>
