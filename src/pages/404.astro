---
import Layout from '../layouts/Layout.astro';

// Served by Cloudflare for any path the build did not emit. A static page
// cannot see which path was asked for, so it says what most misses here are:
// an /errors/<name> problem type that does not exist, or a mistyped slug.
const sections = [
  { name: 'Errors', href: '/errors', blurb: 'Problem types for RFC 9457 responses' },
  { name: 'Status Codes', href: '/status-codes', blurb: 'Every code and when to send it' },
  { name: 'Headers', href: '/headers', blurb: 'Request and response headers' },
  { name: 'Methods', href: '/methods', blurb: 'Safety, idempotency, cacheability' },
  { name: 'Guides', href: '/guides', blurb: 'Long-form API design patterns' },
  { name: 'Specifications', href: '/specifications', blurb: 'OpenAPI, AsyncAPI and the rest' },
  { name: 'Tooling', href: '/tools', blurb: 'Tools by lifecycle stage' },
];
---

<Layout
  title="Page Not Found | apiguide.dev"
  description="There is no page at this address."
  noindex
>
  <main class="max-w-6xl mx-auto px-6 py-16 font-sans">
    <header class="mb-12 border-b border-paper-300 pb-8">
      <p class="text-sm font-semibold text-paper-700 mb-2">404 Not Found</p>
      <h1 class="text-4xl font-extrabold tracking-tight mb-4 text-paper-950">There is no page here</h1>
      <p class="text-lg text-paper-700 max-w-2xl">
        If you followed the <code>type</code> of a problem response, that problem type is not in
        the <a href="/errors" class="text-chartres-600 hover:text-chartres-800 hover:underline">errors catalog</a>.
        Otherwise the address is mistyped or the page has moved. Search with
        <kbd class="px-1.5 py-0.5 rounded border border-paper-300 bg-paper-100 text-sm">⌘K</kbd>,
        or start from a section.
      </p>
    </header>

    <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {sections.map((s) => (
        <li>
          <a
            href={s.href}
            class="block h-full border border-paper-300 rounded-lg p-5 bg-paper-100/50 hover:border-chartres-400 hover:bg-chartres-50/50 transition-colors"
          >
            <span class="block text-lg font-bold text-chartres-600">{s.name}</span>
            <span class="block text-sm text-paper-700 mt-1">{s.blurb}</span>
          </a>
        </li>
      ))}
    </ul>
  </main>
</Layout>
