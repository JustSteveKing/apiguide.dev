---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { guideCategories, guideCategoryThemes } from '../../config/themes';
import IndexHeader from '@/components/IndexHeader.astro';
import SectionJump from '@/components/SectionJump.astro';
import RegistryGroup from '@/components/RegistryGroup.astro';
import RegistryRow from '@/components/RegistryRow.astro';

const allGuides = await getCollection('guides');

/**
 * Grouped, not alphabetical.
 *
 * A flat list of 44 cards made the category badge decorative, which is how
 * more than half of them ended up in a bucket called "core" without anyone
 * noticing. Sections give the taxonomy something to do, so a category that
 * stops discriminating now looks wrong on the page.
 */
const sections = guideCategories
  .map(category => ({
    category,
    ...guideCategoryThemes[category],
    guides: allGuides
      .filter(g => g.data.category === category)
      .sort((a, b) => a.data.title.localeCompare(b.data.title))
  }))
  .filter(section => section.guides.length > 0);
---

<Layout
  title="API Guides & Specifications | apiguide.dev"
  description="In-depth developer guides on API design, versioning, reliability, webhooks, caching, security and agent-readiness."
>
  <main class="max-w-6xl mx-auto px-6 py-16 font-sans">
    <IndexHeader
      crumb="Guides"
      title="Guides"
      intro="Long-form guides to designing HTTP APIs, in eight sections from the shape of a resource to what a model makes of it."
    >
      <SectionJump items={sections.map(section => ({ href: `#cat-${section.category}`, label: section.label, count: section.guides.length }))} />
    </IndexHeader>

    {sections.map(section => (
      <RegistryGroup id={`cat-${section.category}`} title={section.label} count={section.guides.length} blurb={section.blurb}>
        {section.guides.map(g => (
          <RegistryRow href={`/guides/${g.id}`} name={g.data.title} description={g.data.description} />
        ))}
      </RegistryGroup>
    ))}
  </main>
</Layout>
