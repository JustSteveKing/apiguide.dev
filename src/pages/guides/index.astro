---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { guideCategories, guideCategoryThemes } from '../../config/themes';

const allGuides = await getCollection('guides');

/**
 * Grouped, not alphabetical.
 *
 * A flat list of 44 cards made the category badge decorative, which is how
 * more than half of them ended up in a bucket called "core" without anyone
 * noticing. Sections give the taxonomy something to do, so a category that
 * stops discriminating now looks wrong on the page.
 */
const sections = guideCategories
  .map(category => ({
    category,
    ...guideCategoryThemes[category],
    guides: allGuides
      .filter(g => g.data.category === category)
      .sort((a, b) => a.data.title.localeCompare(b.data.title))
  }))
  .filter(section => section.guides.length > 0);
---

<Layout 
  title="API Guides & Specifications | apiguide.dev"
  description="In-depth developer guides on API design, versioning, reliability, webhooks, caching, security and agent-readiness."
>
  <main class="max-w-6xl mx-auto px-6 py-16 font-sans">
    <!-- Header -->
    <header class="mb-12 border-b border-paper-300 pb-8">
      <nav class="mb-4 text-sm" aria-label="Breadcrumb">
        <a href="/" class="text-chartres-600 hover:text-chartres-800 hover:underline">Home</a>
        <span class="mx-2 text-paper-400" aria-hidden="true">/</span>
        <span class="text-paper-600">Guides</span>
      </nav>
      <h1 class="text-4xl font-extrabold tracking-tight mb-4 text-paper-950">Developer Guides</h1>
      <p class="text-lg text-paper-600 max-w-2xl">
        Authoritative guides mapping complex HTTP specifications to concrete web API design patterns, in eight sections from the shape of a resource to what a model makes of it.
      </p>
    </header>

    <!-- Guides List -->
    <div class="space-y-16">
      {sections.map(section => (
        <section aria-labelledby={`cat-${section.category}`}>
          <div class="mb-6 flex flex-wrap items-baseline gap-x-4 gap-y-1 border-b border-paper-300 pb-3">
            <h2 id={`cat-${section.category}`} class="text-2xl font-bold tracking-tight text-paper-950">
              {section.label}
            </h2>
            <span class={`inline-flex items-center px-2.5 py-0.5 rounded text-xxs font-semibold uppercase tracking-wider ${section.badge}`}>
              {section.guides.length} {section.guides.length === 1 ? 'guide' : 'guides'}
            </span>
            <p class="w-full text-sm text-paper-700">{section.blurb}</p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            {section.guides.map(g => (
              <div class="card border border-paper-300 rounded-xl p-6 bg-paper-100/50 hover:bg-paper-100 hover:shadow-md transition-all flex flex-col justify-between">
                <div>
                  <h3 class="text-xl font-bold text-paper-950 mb-3">
                    <a href={`/guides/${g.id}/`} class="text-chartres-600 hover:text-chartres-800 hover:underline">
                      {g.data.title}
                    </a>
                  </h3>
                  <p class="text-sm text-paper-700 leading-relaxed mb-6">
                    {g.data.description}
                  </p>
                </div>
                <div class="text-xs text-paper-600 font-medium border-t border-paper-300 pt-4">
                  <a href={`/guides/${g.id}/`} class="text-chartres-600 hover:underline">
                    Read full guide &rarr;
                  </a>
                </div>
              </div>
            ))}
          </div>
        </section>
      ))}
    </div>

  </main>
</Layout>
