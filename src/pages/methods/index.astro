---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import IndexHeader from '@/components/IndexHeader.astro';

// The methods an API is most likely to use first, then the rest alphabetically.
const verbOrder = ['GET', 'POST', 'PUT', 'PATCH', 'DELETE', 'OPTIONS', 'HEAD', 'QUERY'];
const methods = (await getCollection('methods')).sort((a, b) => {
  const indexA = verbOrder.indexOf(a.data.name);
  const indexB = verbOrder.indexOf(b.data.name);
  if (indexA !== -1 && indexB !== -1) return indexA - indexB;
  if (indexA !== -1) return -1;
  if (indexB !== -1) return 1;
  return a.data.name.localeCompare(b.data.name);
});

const properties = [
  { key: 'safe', label: 'Safe' },
  { key: 'idempotent', label: 'Idempotent' },
  { key: 'cacheable', label: 'Cacheable' },
] as const;
---

<Layout
  title="HTTP Methods Reference Directory | apiguide.dev"
  description="Reference directory of the HTTP request methods (verbs) used in REST APIs, detailing safety, idempotency, and caching behaviors."
>
  <main class="max-w-6xl mx-auto px-6 py-16 font-sans">
    <IndexHeader
      crumb="Methods"
      title="Methods"
      intro="The HTTP request methods, whether each is safe, idempotent and cacheable, and which status codes go with it."
    />

    <div class="surface overflow-x-auto">
    <table class="w-full text-left">
      <caption class="sr-only">HTTP methods and their properties</caption>
      <thead>
        <tr class="border-b border-slate-950/[0.08] text-sm text-slate-700">
          <th scope="col" class="py-3 pl-4 sm:pl-5 pr-3 sm:pr-6 font-medium">Method</th>
          {properties.map(p => <th scope="col" class="py-3 pr-3 sm:pr-6 font-medium">{p.label}</th>)}
          <th scope="col" class="py-3 pr-5 font-medium hidden md:table-cell">What it does</th>
        </tr>
      </thead>
      <tbody>
        {methods.map(m => (
          <tr class="border-b border-slate-950/[0.06] last:border-b-0 hover:bg-slate-950/[0.03] transition-colors">
            <th scope="row" class="py-3 pl-4 sm:pl-5 pr-3 sm:pr-6 font-normal">
              <a href={`/methods/${m.id}`} class="font-mono text-ultra-600 hover:text-ultra-800 hover:underline underline-offset-2">{m.data.name}</a>
              {m.data.draft && <span class="ml-2 text-xs text-slate-700">Draft</span>}
            </th>
            {properties.map(p => (
              <td class={`py-3 pr-3 sm:pr-6 text-sm ${m.data[p.key] ? 'text-slate-950' : 'text-slate-700'}`}>{m.data[p.key] ? 'Yes' : 'No'}</td>
            ))}
            <td class="py-3 pr-5 text-sm text-slate-700 hidden md:table-cell">{m.data.description}</td>
          </tr>
        ))}
      </tbody>
    </table>
    </div>
  </main>
</Layout>
