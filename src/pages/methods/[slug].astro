---
import { pageURL } from "@/utils/pagePath";
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import TableOfContents from '@/components/TableOfContents.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import MetaItem from '../../components/MetaItem.astro';

export async function getStaticPaths() {
  const methods = await getCollection('methods');
  return methods.map(m => ({
    params: { slug: m.id },
    props: { m },
  }));
}

const { m } = Astro.props;
const { Content, headings } = await render(m);

// Fetch all status codes to cross-reference related codes
const allCodes = await getCollection('statusCodes');
const relatedCodes = m.data.relatedCodes
  ? allCodes.filter(c => m.data.relatedCodes.includes(c.data.code))
  : [];
const sortedRelatedCodes = relatedCodes.sort((a, b) => a.data.code - b.data.code);


import { getTechArticleSchema, getBreadcrumbSchema } from '../../utils/jsonLd';
import WireHero from '@/components/WireHero.astro';
import RegistryGroup from '@/components/RegistryGroup.astro';
import RegistryRow from '@/components/RegistryRow.astro';
import { statusCategoryThemes } from '@/config/themes';

const methodJsonLd = [
  getTechArticleSchema({
    headline: `${m.data.name} Request Method Reference`,
    description: m.data.description,
    url: pageURL(Astro.url, Astro.site).href,
    category: "Request Methods"
  }),
  getBreadcrumbSchema([
    { name: "HTTP Methods", path: "/methods" },
    { name: m.data.name, path: `/methods/${m.id}` }
  ])
];
---

<Layout 
  title={`${m.data.name} Request Method | HTTP Verb Reference`}
  description={`Detailed usage patterns, specifications, safety/idempotency rules, and common response codes for the HTTP ${m.data.name} request method.`}
  jsonLd={methodJsonLd}
>
  <main class="max-w-6xl mx-auto px-6 py-16 font-sans">
    <!-- Breadcrumbs Component -->
    <Breadcrumbs items={[
      { name: "Methods", href: "/methods" },
      { name: m.data.name }
    ]} />

    <!-- Draft notice: informational, so violet, not a status colour -->
    {m.data.draft && (
      <div class="bg-violet-100 border border-violet-200 text-violet-900 p-5 rounded-lg mb-8" role="note">
        <h2 class="font-bold text-lg mb-1">Draft: Not Yet Standardized</h2>
        <p class="text-sm">
          This method is still an active IETF Internet-Draft, not a finished RFC. Its name, semantics, and status codes can still change before final publication. Do not rely on it in production APIs yet. Treat this page as a preview rather than a spec.
        </p>
      </div>
    )}

    <!-- Title & Metadata -->
    <header class="mb-10">
      <WireHero
        identity={m.data.name}
        heading
        trail=" request-target HTTP/1.1"
      />
      <p class="text-lg text-slate-700 mt-6 mb-8 max-w-2xl">
        {m.data.description}
      </p>

      <div class="grid grid-cols-1 sm:flex sm:flex-wrap sm:gap-x-12 sm:gap-y-4 py-1 sm:py-4 border-y border-slate-300 text-sm">
        <MetaItem label="Safe" value={m.data.safe ? 'Yes' : 'No, changes server state'} />
        <MetaItem label="Idempotent" value={m.data.idempotent ? 'Yes' : 'No, a retry may repeat the effect'} />
        <MetaItem label="Cacheable" value={m.data.cacheable ? 'Yes, by default' : 'No'} />
      </div>
    </header>

    <!-- Markdown Content Body -->
    <div class="border-b border-slate-300 pb-10 flex flex-col lg:grid lg:grid-cols-[minmax(0,60ch)_minmax(0,1fr)] lg:gap-10">
      <article class="prose max-w-[60ch]">
        <Content />
      </article>
      <TableOfContents headings={headings} />
    </div>

    {sortedRelatedCodes.length > 0 && (
      <div class="mt-12">
        <RegistryGroup id="related-codes" title="Common response codes" count={sortedRelatedCodes.length}>
          {sortedRelatedCodes.map(c => (
            <RegistryRow href={`/status-codes/${c.data.code}`} code={String(c.data.code)} tone={statusCategoryThemes[c.data.category].tone} name={c.data.title} description={c.data.description} />
          ))}
        </RegistryGroup>
      </div>
    )}
  </main>
</Layout>


