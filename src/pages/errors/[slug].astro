---
import { pageURL } from "@/utils/pagePath";
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import TableOfContents from '@/components/TableOfContents.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import MetaItem from '../../components/MetaItem.astro';

export async function getStaticPaths() {
  const errors = await getCollection('errors');
  return errors.map(error => ({
    params: { slug: error.id },
    props: { error },
  }));
}

const { error } = Astro.props as { error: CollectionEntry<'errors'> };
const { Content, headings } = await render(error);

// Fetch all errors to resolve information for related codes
const allErrors: CollectionEntry<'errors'>[] = await getCollection('errors');
const relatedErrors = error.data.relatedCodes
  ? allErrors.filter(e => error.data.relatedCodes?.includes(e.id))
  : [];

// Category theme mapping
import { errorCategoryThemes } from '../../config/themes';

const activeTheme = errorCategoryThemes[error.data.category];
// The URI this page exists to be: the `type` member of an RFC 9457 response.
// When IANA has registered the problem, the registered URI is the one to send
// and this site's URI is an alias that documents it.
const aliasURI = `https://apiguide.dev/errors/${error.id}`;
const registeredType = error.data.registeredType;
const typeURI = registeredType ?? aliasURI;

import { getTechArticleSchema, getBreadcrumbSchema } from '../../utils/jsonLd';
import WireHero from '@/components/WireHero.astro';
import RegistryGroup from '@/components/RegistryGroup.astro';
import RegistryRow from '@/components/RegistryRow.astro';
import { excerpt } from '@/utils/excerpt';

const errorJsonLd = [
  getTechArticleSchema({
    headline: `${error.data.statusCode} ${error.data.title} Error Schema`,
    description: error.data.statusText,
    url: pageURL(Astro.url, Astro.site).href,
    category: activeTheme.label,
    publishedDate: error.data.publishedDate,
    updatedDate: error.data.updatedDate
  }),
  getBreadcrumbSchema([
    { name: "API Errors", path: "/errors" },
    { name: error.data.title, path: `/errors/${error.id}` }
  ])
];
---

<Layout 
  title={`${error.data.title} | API Error Reference`}
  description={`Authoritative reference schema and details for the HTTP ${error.data.statusCode} (${error.data.title}) error.`}
  jsonLd={errorJsonLd}
>
  <main class="max-w-6xl mx-auto px-6 py-16 font-sans">
    <!-- Breadcrumbs Component -->
    <Breadcrumbs items={[
      { name: "Errors", href: "/errors" },
      { name: error.data.title }
    ]} />

    <!-- Deprecation notice: always red, since a deprecated type is a warning -->
    {error.data.deprecated && (
      <div class="bg-red-100 border border-red-200 text-red-900 p-5 rounded-lg mb-8" role="alert">
        <h2 class="font-bold text-lg mb-1">Deprecated</h2>
        <p class="text-sm">
          This error type has been deprecated. If you are designing new API endpoints, avoid throwing this error and consult the related errors listed below.
        </p>
      </div>
    )}

    <!-- Title & Metadata -->
    <header class="mb-10">
      <h1 class="text-4xl font-bold tracking-tight mb-6 text-slate-950">{error.data.title}</h1>
      <WireHero
        lead={'"type": "'}
        identity={typeURI}
        trail={'"'}
        size="md"
        copy={typeURI}
        copyLabel="Copy problem type URI"
        dot={activeTheme.dot}
        label={registeredType ? `IANA-registered problem type, ${activeTheme.label.toLowerCase()}` : `Problem type, ${activeTheme.label.toLowerCase()}`}
      />

      {registeredType && (
        <div class="surface mt-6 px-5 py-4 text-sm text-slate-800" role="note">
          <p class="font-semibold text-slate-950">Registered with IANA</p>
          <p class="mt-1">
            This problem type is in the <a href="https://www.iana.org/assignments/http-problem-types/" class="text-ultra-600 hover:text-ultra-800 hover:underline">IANA HTTP Problem Types registry</a>. Send the registered URI above as the <code>type</code>. <code class="break-all">{aliasURI}</code> also resolves to this page, but a client that recognizes registered types will only recognize the IANA URI.
          </p>
        </div>
      )}

      <div class="mt-8 grid grid-cols-1 sm:flex sm:flex-wrap sm:gap-x-12 sm:gap-y-4 py-1 sm:py-4 border-y border-slate-300 text-sm">
        <MetaItem label="Status code">
          <a href={`/status-codes/${error.data.statusCode}`} class="text-ultra-600 hover:text-ultra-800 hover:underline">
            {error.data.statusCode} {error.data.statusText}
          </a>
        </MetaItem>
        <MetaItem label="Category" value={activeTheme.label} />
        <MetaItem label="Published" value={error.data.publishedDate.toISOString().split('T')[0]} />
        {error.data.updatedDate && (
          <MetaItem label="Updated" value={error.data.updatedDate.toISOString().split('T')[0]} />
        )}
      </div>
    </header>

    <!-- Markdown Content Body -->
    <div class="border-b border-slate-300 pb-10 flex flex-col lg:grid lg:grid-cols-[minmax(0,60ch)_minmax(0,1fr)] lg:gap-10">
      <article class="prose max-w-[60ch]">
        <Content />
      </article>
      <TableOfContents headings={headings} />
    </div>

    {relatedErrors.length > 0 && (
      <div class="mt-12">
        <RegistryGroup id="related-errors" title="Related problem types" count={relatedErrors.length}>
          {relatedErrors.map(r => (
            <RegistryRow href={`/errors/${r.id}`} code={String(r.data.statusCode)} tone={errorCategoryThemes[r.data.category].tone} name={r.data.title} description={excerpt(r.body, 140)} />
          ))}
        </RegistryGroup>
      </div>
    )}
  </main>
</Layout>
