---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import IndexHeader from '@/components/IndexHeader.astro';
import RegistryGroup from '@/components/RegistryGroup.astro';
import RegistryRow from '@/components/RegistryRow.astro';
import { excerpt } from '@/utils/excerpt';
import { errorCategoryThemes } from '@/config/themes';

const errors = (await getCollection('errors'))
  .sort((a, b) => a.data.statusCode - b.data.statusCode || a.data.title.localeCompare(b.data.title));

const groups = [
  { key: 'client-error', code: '4xx', title: 'Client errors' },
  { key: 'server-error', code: '5xx', title: 'Server errors' },
] as const;
---

<Layout
  title="API Errors Reference Catalog | apiguide.dev"
  description="Authoritative reference index of standard API error definitions grouped by Client Errors (4xx) and Server Errors (5xx)."
>
  <main class="max-w-6xl mx-auto px-6 py-16 font-sans">
    <IndexHeader
      crumb="Errors"
      title="Errors"
      intro="Problem types for RFC 9457 responses. Use a page's URL as the type of your problem response, and a client that follows it learns when the error applies and what to do about it."
    />

    {groups.map(g => {
      const entries = errors.filter(e => e.data.category === g.key);
      return entries.length > 0 && (
        <RegistryGroup id={`class-${g.code}`} code={g.code} title={g.title} count={entries.length} marker={errorCategoryThemes[g.key].marker}>
          {entries.map(e => (
            <RegistryRow href={`/errors/${e.id}`} code={String(e.data.statusCode)} name={e.data.title} description={excerpt(e.body, 140)} />
          ))}
        </RegistryGroup>
      );
    })}
  </main>
</Layout>
