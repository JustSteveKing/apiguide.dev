---
import { pageURL } from "@/utils/pagePath";
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import TableOfContents from '@/components/TableOfContents.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import MetaItem from '../../components/MetaItem.astro';

export async function getStaticPaths() {
  const specs = await getCollection('specifications');
  return specs.map(spec => ({
    params: { slug: spec.id },
    props: { spec },
  }));
}

const { spec } = Astro.props;
const { Content, headings } = await render(spec);

import { getTechArticleSchema, getBreadcrumbSchema } from '../../utils/jsonLd';

const specJsonLd = [
  getTechArticleSchema({
    headline: `${spec.data.title} Reference Guide`,
    description: spec.data.description,
    url: pageURL(Astro.url, Astro.site).href,
    category: "API Specifications",
    aboutName: spec.data.title,
    aboutUrl: spec.data.officialUrl
  }),
  getBreadcrumbSchema([
    { name: "Specifications", path: "/specifications" },
    { name: spec.data.title, path: `/specifications/${spec.id}` }
  ])
];
---

<Layout 
  title={`${spec.data.title} Reference Guide | apiguide.dev`}
  description={spec.data.description}
  jsonLd={specJsonLd}
>
  <main class="max-w-6xl mx-auto px-6 py-16 font-sans">
    <!-- Breadcrumbs Component -->
    <Breadcrumbs items={[
      { name: "Specifications", href: "/specifications" },
      { name: spec.data.title }
    ]} />

    <!-- Title & Metadata -->
    <header class="mb-10">
      <h1 class="text-4xl font-extrabold tracking-tight mb-4 text-slate-950 font-display">
        {spec.data.title}
      </h1>
      <p class="text-lg text-slate-600 mb-6">
        {spec.data.description}
      </p>
      
      <div class="grid grid-cols-1 sm:flex sm:flex-wrap sm:gap-x-12 sm:gap-y-4 py-1 sm:py-4 border-y border-slate-300 text-sm">
        <MetaItem label="Current version">
          {spec.data.currentVersion}
        </MetaItem>
        <MetaItem label="Specification">
          <a href={spec.data.officialUrl} target="_blank" rel="noopener noreferrer" class="text-ultra-600 hover:text-ultra-800 hover:underline break-all">
            {new URL(spec.data.officialUrl).host.replace(/^www\./, '')}
          </a>
        </MetaItem>
      </div>
    </header>

    <!-- Markdown Content Body -->
    <div class="flex flex-col lg:grid lg:grid-cols-[minmax(0,60ch)_minmax(0,1fr)] lg:gap-10">
      <article class="prose max-w-[60ch]">
        <Content />
      </article>
      <TableOfContents headings={headings} />
    </div>
  </main>
</Layout>

<script is:inline define:vars={{ specTitle: spec.data.title, specOfficialUrl: spec.data.officialUrl, specVersion: spec.data.currentVersion }}>
  document.addEventListener('astro:page-load', function () {
    var externalLink = document.querySelector('a[href="' + specOfficialUrl + '"][target="_blank"]');
    if (externalLink) {
      externalLink.addEventListener('click', function () {
        window.posthog?.capture('specification_external_link_clicked', {
          spec_title: specTitle,
          spec_url: specOfficialUrl,
          spec_version: specVersion,
        });
      });
    }
  });
</script>


