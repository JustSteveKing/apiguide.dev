---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import IndexHeader from '@/components/IndexHeader.astro';
import RegistryGroup from '@/components/RegistryGroup.astro';
import RegistryRow from '@/components/RegistryRow.astro';

const specs = (await getCollection('specifications')).sort((a, b) => a.data.title.localeCompare(b.data.title));
---

<Layout
  title="API Specifications Directory | apiguide.dev"
  description="Reference catalog of the major specification standards defining REST, event-driven, and payload grammar structures for modern web APIs."
>
  <main class="max-w-6xl mx-auto px-6 py-16 font-sans">
    <IndexHeader
      crumb="Specifications"
      title="Specifications"
      intro="The specifications that define API contracts, message formats and schemas, with the current version of each."
    />

    <RegistryGroup id="all-specifications" title="All specifications" count={specs.length}>
      {specs.map(s => (
        <RegistryRow href={`/specifications/${s.id}`} name={s.data.title} description={s.data.description} note={s.data.currentVersion} />
      ))}
    </RegistryGroup>
  </main>
</Layout>
