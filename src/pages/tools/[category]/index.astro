---
import { getCollection } from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import IndexHeader from '@/components/IndexHeader.astro';
import RegistryGroup from '@/components/RegistryGroup.astro';
import RegistryRow from '@/components/RegistryRow.astro';
import { toolCategories, toolCategoryThemes, pricingLabels } from '@/config/themes';

export function getStaticPaths() {
  return toolCategories.map(id => ({ params: { category: id }, props: { id } }));
}

const { id } = Astro.props as { id: (typeof toolCategories)[number] };
const category = toolCategoryThemes[id];
const tools = (await getCollection('tools'))
  .filter(t => t.data.category === id)
  .sort((a, b) => a.data.name.localeCompare(b.data.name));
---

<Layout
  title={`${category.label} API Tools | apiguide.dev`}
  description={category.blurb}
>
  <main class="max-w-6xl mx-auto px-6 py-16 font-sans">
    <IndexHeader
      crumb={category.label}
      parent={{ name: 'Tools', href: '/tools' }}
      title={category.label}
      intro={category.blurb}
    />

    <RegistryGroup id={`cat-${id}`} title={`All ${category.label.toLowerCase()} tools`} count={tools.length}>
      {tools.map(t => (
        <RegistryRow href={`/tools/${id}/${t.id}`} name={t.data.name} description={t.data.description} note={pricingLabels[t.data.pricing]} />
      ))}
    </RegistryGroup>
  </main>
</Layout>
