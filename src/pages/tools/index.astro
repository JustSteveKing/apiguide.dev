---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import IndexHeader from '@/components/IndexHeader.astro';
import SectionJump from '@/components/SectionJump.astro';
import RegistryGroup from '@/components/RegistryGroup.astro';
import RegistryRow from '@/components/RegistryRow.astro';
import { toolCategories, toolCategoryThemes, pricingLabels } from '@/config/themes';

const allTools = await getCollection('tools');

// Every tool on one page, grouped: a reader looking for a mock server should
// not have to guess which category card it sits behind.
const groups = toolCategories
  .map(id => ({
    id,
    ...toolCategoryThemes[id],
    tools: allTools.filter(t => t.data.category === id).sort((a, b) => a.data.name.localeCompare(b.data.name)),
  }))
  .filter(g => g.tools.length > 0);
---

<Layout
  title="API Lifecycle Tooling Directory | apiguide.dev"
  description="Explore the best tools for web APIs across the entire development lifecycle, grouped by category."
>
  <main class="max-w-6xl mx-auto px-6 py-16 font-sans">
    <IndexHeader
      crumb="Tools"
      title="Tools"
      intro="Tools for designing, testing, running and watching HTTP APIs, grouped by what they do."
    >
      <SectionJump items={groups.map(g => ({ href: `#cat-${g.id}`, label: g.label, count: g.tools.length }))} />
    </IndexHeader>

    {groups.map(g => (
      <RegistryGroup id={`cat-${g.id}`} title={g.label} count={g.tools.length} blurb={g.blurb}>
        {g.tools.map(t => (
          <RegistryRow href={`/tools/${t.data.category}/${t.id}`} name={t.data.name} description={t.data.description} note={pricingLabels[t.data.pricing]} />
        ))}
      </RegistryGroup>
    ))}
  </main>
</Layout>
