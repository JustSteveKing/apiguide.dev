{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "apiguidedev",
  "main": "src/worker.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/errors/*"]
  },
  "observability": {
    "enabled": true
  },
  "compatibility_date": "2026-07-08",
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
